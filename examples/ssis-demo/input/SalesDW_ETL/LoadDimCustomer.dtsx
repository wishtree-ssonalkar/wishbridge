                        <property containsID="true" dataType="System.String" description="Derived Column Expression" name="Expression">LOWER(SUBSTRING(Email, FINDSTRING(Email, "@", 1) + 1, LEN(Email)))</property>
                        <property dataType="System.String" description="Derived Column Friendly Expression" expressionType="Notify" name="FriendlyExpression">LOWER(SUBSTRING(Email, FINDSTRING(Email, "@", 1) + 1, LEN(Email)))</property>
