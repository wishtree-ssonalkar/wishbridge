                      <inputColumn refId="Package\Stage Customers\Add Derived Columns.Inputs[Derived Column Input].Columns[Email]" cachedDataType="wstr" cachedLength="200" cachedName="Email" lineageId="Package\Stage Customers\Customer Source.Outputs[OLE DB Source Output].Columns[Email]" />
